#!/bin/bash
# FontKit WSL X11 Setup Script

set -e

echo "╔════════════════════════════════════════╗"
echo "║   FontKit WSL X11 Setup Script         ║"
echo "╚════════════════════════════════════════╝"
echo ""

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Check if running on Linux
if [[ ! "$(uname -s)" =~ Linux ]]; then
    echo -e "${RED}Error: This script is for Linux/WSL only${NC}"
    exit 1
fi

echo -e "${CYAN}Step 1: Checking X11 libraries...${NC}"
if dpkg -l | grep -q libx11-dev; then
    echo -e "${GREEN}✓ libx11-dev already installed${NC}"
else
    echo -e "${YELLOW}Installing libx11-dev...${NC}"
    sudo apt update
    sudo apt install -y libx11-dev
    echo -e "${GREEN}✓ libx11-dev installed${NC}"
fi

echo ""
echo -e "${CYAN}Step 2: Setting up DISPLAY variable...${NC}"

# Check if DISPLAY is already set
if [ -z "$DISPLAY" ]; then
    export DISPLAY=:0
    echo -e "${GREEN}✓ DISPLAY set to :0${NC}"
else
    echo -e "${GREEN}✓ DISPLAY already set to $DISPLAY${NC}"
fi

# Add to .bashrc if not already there
if ! grep -q "export DISPLAY=:0" ~/.bashrc; then
    echo "" >> ~/.bashrc
    echo "# X11 Display for WSL" >> ~/.bashrc
    echo "export DISPLAY=:0" >> ~/.bashrc
    echo -e "${GREEN}✓ Added DISPLAY to ~/.bashrc${NC}"
else
    echo -e "${GREEN}✓ DISPLAY already in ~/.bashrc${NC}"
fi

echo ""
echo -e "${CYAN}Step 3: Installing X11 test tools...${NC}"
if command -v xeyes &> /dev/null; then
    echo -e "${GREEN}✓ x11-apps already installed${NC}"
else
    echo -e "${YELLOW}Installing x11-apps (for testing)...${NC}"
    sudo apt install -y x11-apps
    echo -e "${GREEN}✓ x11-apps installed${NC}"
fi

echo ""
echo -e "${CYAN}Step 4: Testing X11 connection...${NC}"
echo -e "${YELLOW}Attempting to connect to X server...${NC}"

if xset q &>/dev/null; then
    echo -e "${GREEN}✓ X11 connection successful!${NC}"
    echo ""
    echo -e "${GREEN}═══════════════════════════════════════${NC}"
    echo -e "${GREEN}  Setup Complete! ✓${NC}"
    echo -e "${GREEN}═══════════════════════════════════════${NC}"
    echo ""
    echo -e "${CYAN}Next steps:${NC}"
    echo "  1. Build FontKit:"
    echo -e "     ${YELLOW}make clean && make${NC}"
    echo ""
    echo "  2. Build WSL demo:"
    echo -e "     ${YELLOW}make wsl${NC}"
    echo ""
    echo "  3. Run the demo:"
    echo -e "     ${YELLOW}./build/wsl_demo${NC}"
    echo ""
    echo -e "${CYAN}Test X11 now:${NC}"
    echo -e "     ${YELLOW}xeyes &${NC}"
    echo ""
else
    echo -e "${RED}✗ Cannot connect to X server!${NC}"
    echo ""
    echo -e "${YELLOW}Troubleshooting steps:${NC}"
    echo ""
    echo "1. Make sure X server is running on Windows:"
    echo "   - Download VcXsrv: https://sourceforge.net/projects/vcxsrv/"
    echo "   - Run XLaunch from Start Menu"
    echo "   - Settings:"
    echo "     • Multiple windows"
    echo "     • Start no client"
    echo "     • Disable access control"
    echo ""
    echo "2. Restart WSL and run this script again:"
    echo "   ./wsl.sh"
    echo ""
fi
